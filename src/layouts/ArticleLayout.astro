---
import BaseLayout from './BaseLayout.astro';

export interface Props {
  title: string;
  subtitle?: string;
  date: string;
  author: string;
  tags?: string[];
  coverImage?: string;
}

const { title, subtitle, date, author, tags = [], coverImage } = Astro.props;
const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');

const formattedDate = new Date(date).toLocaleDateString('en-GB', {
  year: 'numeric', month: 'long', day: 'numeric'
});

const tagColorMap: Record<string, string> = {
  fire: 'fire', peatland: 'fire', ENSO: 'ml', 'machine-learning': 'ml',
  SAR: 'sar', 'remote-sensing': 'remote-sensing', methodology: 'ml', mangrove: '',
  GEE: '', suitability: '', Bengkalis: '', 'Sentinel-1': 'sar',
};
---

<BaseLayout
  title={title}
  description={subtitle}
  image={coverImage}
  ogType="article"
  publishedTime={new Date(date).toISOString()}
>
  <!-- Article hero — TTDK banner gradient (brand-subtle → base) -->
  <header class="article-hero">
    <div class="hero-track">
      <!-- Breadcrumb -->
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href={`${BASE}/`}>Stories</a>
        <span class="sep" aria-hidden="true">→</span>
        <span aria-current="page">{tags[0] || 'Analysis'}</span>
      </nav>

      <!-- Tags -->
      <div class="tag-row">
        {tags.map(tag => (
          <span class={`tag ${tagColorMap[tag] ?? ''}`}>{tag}</span>
        ))}
      </div>

      <h1>{title}</h1>
      {subtitle && <p class="hero-subtitle">{subtitle}</p>}

      <div class="hero-meta">
        <div class="meta-author">
          <div class="author-avatar">M</div>
          <div>
            <div class="author-name">{author} · <span class="author-handle">@mamed/rifqy</span></div>
            <time class="pub-date">{formattedDate}</time>
          </div>
        </div>
        <div class="meta-read">
          <span class="ttdk-badge" data-variant="neutral" data-appearance="outline" data-size="sm" data-rounded="full">GIS Analysis</span>
        </div>
      </div>
    </div>

  </header>

  <!-- Article body -->
  <article class="article-body">
    <slot />
  </article>
</BaseLayout>

<style>
  .article-hero {
    position: relative;
    padding: calc(var(--nav-h) + var(--ttdk-spacing-3xl)) var(--ttdk-grid-mobile-margin) var(--ttdk-spacing-xxl);
    border-bottom: 1px solid var(--border);
    overflow: hidden;
    /* same gradient as .ttdk-banner[data-appearance=gradient][data-variant=primary] */
    background: var(--hero-gradient);
  }

  .hero-track {
    position: relative;
    z-index: 2;
    max-width: var(--col-text);
    margin: 0 auto;
  }

  /* TTDK Breadcrumb, size sm (12px, gap 6px), arrow separator */
  .breadcrumb {
    display: flex; align-items: center; gap: 6px;
    font-size: var(--ttdk-font-size-12); font-weight: var(--ttdk-font-weight-medium);
    color: var(--text-muted); margin-bottom: var(--ttdk-spacing-lg);
  }
  .breadcrumb a { color: var(--text-muted); }
  .breadcrumb a:hover { color: var(--teal-text); }
  .breadcrumb .sep { color: var(--text-dim); }
  .breadcrumb [aria-current] { color: var(--teal-text); font-weight: var(--ttdk-font-weight-semibold); }

  .tag-row { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-bottom: 1.25rem; }

  h1 { margin-bottom: 1rem; }

  .hero-subtitle {
    font-family: var(--font-sans);
    font-size: var(--ttdk-font-size-18);
    font-weight: 400;
    color: var(--text-muted);
    line-height: var(--ttdk-line-height-body);
    max-width: 600px;
    margin-bottom: 2rem;
  }

  .hero-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-md);
  }

  .meta-author { display: flex; align-items: center; gap: 0.75rem; }

  .author-avatar {
    width: 36px; height: 36px;
    background: var(--teal);
    color: var(--ttdk-text-icon-stay-white);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-weight: 800; font-size: 0.85rem;
    flex-shrink: 0;
  }

  .author-name {
    font-size: 0.875rem; font-weight: 600;
    color: var(--text-bright); line-height: 1.2;
  }
  .author-handle { color: var(--teal-text); font-weight: 500; }
  .pub-date { font-size: var(--ttdk-font-size-12); color: var(--text-muted); display: block; margin-top: 0.1rem; }

  /* Article body */
  .article-body { padding: var(--ttdk-spacing-xxl) var(--ttdk-grid-mobile-margin) var(--ttdk-spacing-xl); }
  .article-body :global(p), .article-body :global(li) { font-size: 17px; line-height: 1.7; }
  .article-body :global(p)          { max-width: var(--col-text); margin-left: auto; margin-right: auto; }
  .article-body :global(h2)         { max-width: var(--col-text); margin-left: auto; margin-right: auto; }
  .article-body :global(h3)         { max-width: var(--col-text); margin-left: auto; margin-right: auto; }
  .article-body :global(blockquote) { max-width: var(--col-text); margin-left: auto; margin-right: auto; }
  .article-body :global(table)      { max-width: var(--col-text); margin-left: auto; margin-right: auto; }
  .article-body :global(ul), .article-body :global(ol) {
    max-width: var(--col-text); margin-left: auto; margin-right: auto; padding-left: 1.5rem;
  }
  .article-body :global(li) { margin-bottom: 0.35rem; color: var(--text); }

  /* Footnotes (GFM): inline markers and the numbered "Notes and references" list */
  .article-body :global(sup a[data-footnote-ref]) {
    font-size: 0.72em; font-weight: 700; padding: 0 0.12em; margin-left: 0.05em;
    color: var(--teal-text); text-decoration: none;
  }
  .article-body :global(section.footnotes) {
    max-width: var(--col-text); margin: 4rem auto 2rem; padding-top: 1.5rem;
    border-top: 1px solid var(--border-md);
  }
  .article-body :global(section.footnotes .footnotes-heading) {
    font-size: 0.78rem; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--text-muted); font-family: var(--font-sans); font-weight: 700;
    margin: 0 0 1rem; max-width: none;
  }
  .article-body :global(section.footnotes ol) { padding-left: 1.4rem; max-width: none; }
  .article-body :global(section.footnotes li) {
    font-size: 0.8rem; line-height: 1.6; color: var(--text-muted);
    margin-bottom: 0.7rem; scroll-margin-top: calc(var(--nav-h) + 1.5rem);
  }
  .article-body :global(section.footnotes li p) { font-size: 0.8rem; margin: 0; max-width: none; color: var(--text-muted); }
  .article-body :global(section.footnotes li:target) { background: var(--teal-dim); border-radius: 3px; }
  .article-body :global(section.footnotes a[data-footnote-backref]) { margin-left: 0.35rem; text-decoration: none; }
  .article-body :global(section.footnotes em) { color: var(--text); }
  /* long DOIs and PDF URLs in references must wrap instead of widening the page on phones */
  .article-body :global(section.footnotes a) { overflow-wrap: anywhere; }
  .article-body :global(p code), .article-body :global(li code) { overflow-wrap: anywhere; }
  /* markdown tables scroll inside the column instead of widening the page */
  .article-body > :global(table) { display: block; max-width: 100%; overflow-x: auto; }
  .article-body :global(sup a[data-footnote-ref]) { scroll-margin-top: calc(var(--nav-h) + 1.5rem); }
</style>
