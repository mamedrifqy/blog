---
import BaseLayout from '../layouts/BaseLayout.astro';
import '@ttdk-design-system/library-react/web/banner/banner.css';
import ThesisMindMap from '../components/ThesisMindMap.jsx';
import { getCollection } from 'astro:content';
import { clusters } from '../data/clusters';
import mindmap from '../data/thesis-mindmap.json';

const all = (await getCollection('articles')).filter(a => !a.data.draft);

// Chapter strings like "4.9" or "4.2, 4.5" sort by their first number: 1.3 < 4.2 < 4.10 < 5.
const chapterKey = (c?: string): number[] => {
  const m = c?.match(/\d+(?:\.\d+)*/);
  return m ? m[0].split('.').map(Number) : [99];
};
const byChapter = (a: typeof all[number], b: typeof all[number]) => {
  const ka = chapterKey(a.data.chapter), kb = chapterKey(b.data.chapter);
  for (let i = 0; i < Math.max(ka.length, kb.length); i++) {
    const d = (ka[i] ?? -1) - (kb[i] ?? -1);
    if (d) return d;
  }
  return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
};

const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
const tagColorMap: Record<string, string> = {
  fire: 'fire', peatland: 'fire', ENSO: 'ml', 'machine-learning': 'ml',
  SAR: 'sar', 'remote-sensing': 'remote-sensing',
};

// slug -> title for every published post, so the mind map only links to pages that exist
const postIndex: Record<string, string> = Object.fromEntries(all.map(a => [a.slug, a.data.title]));

const sections = clusters.map(c => {
  const posts = all.filter(a => a.data.cluster === c.id).sort(byChapter);
  const featured = posts.find(p => p.data.featured);
  const rest = posts.filter(p => p !== featured);
  const groups = c.groups
    ? c.groups.map(g => ({ ...g, posts: rest.filter(p => g.majors.includes(chapterKey(p.data.chapter)[0])) }))
    : [{ label: '', sub: '', majors: [], posts: rest }];
  // anything without a matching group still shows up, at the end
  const placed = new Set(groups.flatMap(g => g.posts));
  const loose = rest.filter(p => !placed.has(p));
  if (loose.length) groups.push({ label: 'More', sub: '', majors: [], posts: loose });
  return { cluster: c, posts, featured, groups: groups.filter(g => g.posts.length) };
});
---

<BaseLayout title="Stories" activePage="home">

  <!-- ── Intro ─────────────────────────────────────────────── -->
  <section class="home-top container">
    <span class="ttdk-badge top-eyebrow" data-variant="primary" data-appearance="soft" data-size="sm" data-rounded="full">
      <span class="eyebrow-dot" aria-hidden="true"></span>Geospatial Storytelling · Southeast Asia
    </span>
    <h1 class="top-headline">Maps that <span class="hl">tell the story.</span></h1>
    <p class="top-body">
      Spatial analysis, remote sensing and data-driven narratives on fire, drought and disaster risk
      in Riau, Indonesia. Stories are grouped into clusters; start with the first.
    </p>
  </section>

  {sections.map(({ cluster, posts, featured, groups }) => (
    <section class="cluster container" id={`cluster-${cluster.id}`} aria-labelledby={`cluster-${cluster.id}-title`}>

      <header class="cluster-head ttdk-banner" data-variant="primary" data-appearance="gradient" data-size="xl" data-rounded="lg">
        <div class="cluster-kicker">
          <span class="ttdk-badge" data-variant="primary" data-appearance="solid" data-size="sm" data-rounded="full">Cluster {cluster.number}</span>
          <span class="cluster-label">{cluster.label}</span>
        </div>
        <h2 class="cluster-title" id={`cluster-${cluster.id}-title`}>{cluster.title}</h2>
        <p class="cluster-sub">{cluster.subtitle}</p>
        <p class="cluster-blurb">{cluster.blurb}</p>
        <div class="cluster-foot">
          <ul class="cluster-meta">
            <li><b>{posts.length}</b> {posts.length === 1 ? 'story' : 'stories'}</li>
            <li><b>11</b> kecamatan</li>
            <li><b>10 yr</b> satellite record</li>
            <li>Universitas Riau · S2</li>
          </ul>
          {cluster.mindmap && (
            <ThesisMindMap client:load data={mindmap} posts={postIndex} base={BASE} label="Thesis mind map" />
          )}
        </div>
      </header>

      {featured && (
        <a href={`${BASE}/${featured.slug}`} class="feature-card ttdk-card" data-variant="elevated" data-rounded="lg" data-size="lg" data-hoverable="true">
          <div class="feature-meta">
            <span class="ttdk-badge" data-variant="warning" data-appearance="soft" data-size="sm" data-rounded="full">Start here</span>
            <time class="feature-date">
              {new Date(featured.data.date).toLocaleDateString('en-GB', {year:'numeric',month:'short',day:'numeric'})}
            </time>
          </div>
          <h3 class="feature-title">{featured.data.title}</h3>
          {featured.data.subtitle && <p class="feature-sub">{featured.data.subtitle}</p>}
          <span class="ttdk-button feature-cta" data-variant="primary" data-appearance="solid" data-size="sm" data-rounded="md">Read the overview <span class="cta-arrow">→</span></span>
        </a>
      )}

      {groups.map(g => (
        <div class="group">
          {g.label && (
            <div class="group-head">
              <h3>{g.label}</h3>
              {g.sub && <span>{g.sub}</span>}
            </div>
          )}
          <div class="articles-grid">
            {g.posts.map(article => (
              <a href={`${BASE}/${article.slug}`} class="article-card ttdk-card" data-variant="bordered" data-rounded="md" data-hoverable="true">
                <div class="card-top">
                  {article.data.chapter && <span class="ttdk-badge card-chapter" data-variant="neutral" data-appearance="soft" data-size="sm" data-rounded="md">§ {article.data.chapter}</span>}
                  <div class="card-tags">
                    {article.data.tags.slice(0, 2).map(tag => (
                      <span class={`tag ${tagColorMap[tag] ?? ''}`}>{tag}</span>
                    ))}
                  </div>
                </div>
                <h4 class="card-title">{article.data.title}</h4>
                {article.data.subtitle && <p class="card-sub">{article.data.subtitle}</p>}
                <div class="card-footer">
                  <time>{new Date(article.data.date).toLocaleDateString('en-GB',{year:'numeric',month:'short'})}</time>
                  <span class="card-read">Read →</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      ))}
    </section>
  ))}

  <!-- ── About strip ───────────────────────────────────────── -->
  <section class="about-strip container">
    <div class="strip-inner">
      <div class="strip-text">
        <div class="section-label">About this project</div>
        <p>
          <strong>medrifmaps</strong> is the geospatial research portfolio of mamed/rifqy —
          a geospatial analyst based in Riau Province, Indonesia, pursuing an S2 in
          Disaster Management at Universitas Riau. The work spans peatland fire
          analysis, mangrove rehabilitation mapping, and machine learning for
          disaster risk reduction.
        </p>
        <a href={`${BASE}/about`} class="strip-link">Learn more about the project →</a>
      </div>
      <div class="strip-tools">
        <div class="tools-label">Tools & data sources</div>
        <div class="tools-grid">
          {['Google Earth Engine','DBSCAN','Sentinel-1 SAR','Sentinel-2','CHIRPS v2.0','ERA5-Land','Hansen GFC','NASA FIRMS (MODIS)','MapLibre GL JS'].map(t => (
            <span class="ttdk-badge" data-variant="neutral" data-appearance="outline" data-size="sm" data-rounded="full">{t}</span>
          ))}
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
/* Styled with TTDK tokens; cards/badges/banner/button are TTDK component CSS. */

/* ── Intro ─────────────────────────────────────────────────── */
.home-top { padding-top: calc(var(--nav-h) + var(--ttdk-spacing-xxl)); padding-bottom: var(--ttdk-spacing-xl); }
.top-eyebrow { gap: var(--ttdk-spacing-xs); margin-bottom: var(--ttdk-spacing-md); }
.eyebrow-dot { width: 6px; height: 6px; background: var(--teal); border-radius: 50%; }
.top-headline {
  font-size: clamp(2.2rem, 5.5vw, var(--ttdk-font-size-64)); font-weight: var(--ttdk-font-weight-extrabold);
  letter-spacing: -0.03em; line-height: 1.05; margin-bottom: var(--ttdk-spacing-md); color: var(--text-bright);
}
.top-headline .hl { color: var(--teal); }
.top-body { font-size: var(--ttdk-font-size-18); color: var(--text-muted); line-height: var(--ttdk-line-height-body); max-width: 600px; margin: 0; }

/* ── Cluster (TTDK Banner, gradient/primary/xl) ─────────────── */
.cluster { padding-bottom: var(--ttdk-spacing-xxl); }
.cluster-head { display: block; margin-bottom: var(--ttdk-spacing-md); color: var(--text); }
.cluster-kicker { display: flex; align-items: center; gap: var(--ttdk-spacing-sm); flex-wrap: wrap; margin-bottom: var(--ttdk-spacing-md); }
.cluster-label { font-size: var(--ttdk-font-size-12); font-weight: var(--ttdk-font-weight-semibold); color: var(--text-muted); }
.cluster-title {
  font-size: clamp(1.4rem, 3vw, var(--ttdk-font-size-32)); line-height: var(--ttdk-line-height-heading);
  color: var(--text-bright); margin: 0 0 var(--ttdk-spacing-xs); max-width: 880px;
}
.cluster-sub { font-size: var(--ttdk-font-size-16); font-weight: var(--ttdk-font-weight-semibold); color: var(--teal-text); margin: 0 0 var(--ttdk-spacing-sm); }
.cluster-blurb { font-size: var(--ttdk-font-size-14); color: var(--text-muted); line-height: var(--ttdk-line-height-body); max-width: 700px; margin: 0 0 var(--ttdk-spacing-lg); }
.cluster-foot { display: flex; align-items: center; justify-content: space-between; gap: var(--ttdk-spacing-md) var(--ttdk-spacing-xl); flex-wrap: wrap; padding-top: var(--ttdk-spacing-md); border-top: 1px solid var(--border-md); }
.cluster-meta { display: flex; flex-wrap: wrap; gap: var(--ttdk-spacing-xs) var(--ttdk-spacing-xl); list-style: none; margin: 0; padding: 0; font-size: var(--ttdk-font-size-12); color: var(--text-muted); }
.cluster-meta b { font-size: var(--ttdk-font-size-20); font-weight: var(--ttdk-font-weight-extrabold); color: var(--text-bright); margin-right: var(--ttdk-spacing-xxs); }

/* ── Feature card (TTDK Card elevated) ──────────────────────── */
.feature-card { padding: var(--ttdk-spacing-lg) var(--ttdk-spacing-xl); text-decoration: none; color: inherit; margin-bottom: var(--ttdk-spacing-xs); }
.feature-card:hover { text-decoration: none; }
.feature-meta { display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--ttdk-spacing-sm); flex-wrap: wrap; gap: var(--ttdk-spacing-xs); }
.feature-date { font-size: var(--ttdk-font-size-12); color: var(--text-muted); }
.feature-title { font-size: clamp(1.25rem, 2.6vw, var(--ttdk-font-size-24)); color: var(--text-bright); margin: 0 0 var(--ttdk-spacing-xs); }
.feature-sub { font-size: var(--ttdk-font-size-14); color: var(--text-muted); max-width: 680px; line-height: var(--ttdk-line-height-body); margin: 0 0 var(--ttdk-spacing-md); }
.feature-cta { align-self: flex-start; width: max-content; }
.cta-arrow { transition: transform 0.2s; }
.feature-card:hover .cta-arrow { transform: translateX(4px); }

/* ── Groups and cards (TTDK Card bordered, 12-col grid gutter) ─ */
.group { margin-top: var(--ttdk-spacing-xl); }
.group-head { display: flex; align-items: baseline; gap: var(--ttdk-spacing-xs) var(--ttdk-spacing-md); flex-wrap: wrap; margin-bottom: var(--ttdk-spacing-md); }
.group-head h3 { font-size: var(--ttdk-font-size-20); color: var(--text-bright); margin: 0; }
.group-head span { font-size: var(--ttdk-font-size-12); color: var(--text-muted); }
.articles-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(264px, 100%), 1fr)); gap: var(--ttdk-grid-desktop-gutter); }
.article-card { padding: var(--ttdk-spacing-lg) var(--ttdk-spacing-lg) var(--ttdk-spacing-md); text-decoration: none; color: inherit; }
.article-card:hover { text-decoration: none; }
.card-top { display: flex; align-items: center; justify-content: space-between; gap: var(--ttdk-spacing-xs); flex-wrap: wrap; margin-bottom: var(--ttdk-spacing-sm); }
.card-chapter { min-width: 0; font-variant-numeric: tabular-nums; }
.card-tags { display: flex; gap: var(--ttdk-spacing-xxs); flex-wrap: wrap; }
.card-title { font-size: var(--ttdk-font-size-16); font-weight: var(--ttdk-font-weight-bold); color: var(--text-bright); line-height: 1.35; margin: 0 0 var(--ttdk-spacing-xs); }
.card-sub { font-size: var(--ttdk-font-size-14); color: var(--text-muted); line-height: var(--ttdk-line-height-body); flex: 1; margin: 0 0 var(--ttdk-spacing-md); }
.card-footer {
  display: flex; justify-content: space-between; align-items: center; font-size: var(--ttdk-font-size-12); color: var(--text-muted);
  padding-top: var(--ttdk-spacing-sm); border-top: 1px solid var(--border); margin-top: auto;
}
.card-read { color: var(--teal-text); font-weight: var(--ttdk-font-weight-semibold); }

.section-label { font-size: var(--ttdk-font-size-12); font-weight: var(--ttdk-font-weight-bold); letter-spacing: .08em; text-transform: uppercase; color: var(--text-muted); }

@media (max-width: 640px) {
  .cluster-head { padding: var(--ttdk-spacing-lg) var(--ttdk-spacing-md) !important; }
  .feature-card { padding: var(--ttdk-spacing-lg) var(--ttdk-spacing-md); }
  .articles-grid { gap: var(--ttdk-grid-mobile-gutter); }
}

/* ── About strip ───────────────────────────────────────────── */
.about-strip { padding-top: var(--ttdk-spacing-3xl); padding-bottom: var(--ttdk-spacing-4xl); }
.strip-inner { display: grid; grid-template-columns: 1fr 1fr; gap: var(--ttdk-spacing-3xl); align-items: start; }
.strip-text .section-label { margin-bottom: var(--ttdk-spacing-md); }
.strip-text p { font-size: var(--ttdk-font-size-16); color: var(--text-muted); line-height: var(--ttdk-line-height-body); margin-bottom: var(--ttdk-spacing-md); }
.strip-link { font-size: var(--ttdk-font-size-14); font-weight: var(--ttdk-font-weight-bold); }
.tools-label { font-size: var(--ttdk-font-size-12); font-weight: var(--ttdk-font-weight-bold); letter-spacing: .08em; text-transform: uppercase; color: var(--text-muted); margin-bottom: var(--ttdk-spacing-md); }
.tools-grid { display: flex; flex-wrap: wrap; gap: var(--ttdk-spacing-xs); }

@media (max-width: 768px) {
  .strip-inner { grid-template-columns: 1fr; gap: var(--ttdk-spacing-xl); }
}
</style>
