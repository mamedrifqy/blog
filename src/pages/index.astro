---
import BaseLayout from '../layouts/BaseLayout.astro';
import ThesisMindMap from '../components/ThesisMindMap.jsx';
import { getCollection } from 'astro:content';
import { clusters } from '../data/clusters';
import mindmap from '../data/thesis-mindmap.json';

const all = (await getCollection('articles')).filter(a => !a.data.draft);

// Chapter strings like "4.9" or "4.2, 4.5" sort by their first number: 1.3 < 4.2 < 4.10 < 5.
const chapterKey = (c?: string): number[] => {
  const m = c?.match(/\d+(?:\.\d+)*/);
  return m ? m[0].split('.').map(Number) : [99];
};
const byChapter = (a: typeof all[number], b: typeof all[number]) => {
  const ka = chapterKey(a.data.chapter), kb = chapterKey(b.data.chapter);
  for (let i = 0; i < Math.max(ka.length, kb.length); i++) {
    const d = (ka[i] ?? -1) - (kb[i] ?? -1);
    if (d) return d;
  }
  return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
};

const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
const tagColorMap: Record<string, string> = {
  fire: 'fire', peatland: 'fire', ENSO: 'ml', 'machine-learning': 'ml',
  SAR: 'sar', 'remote-sensing': 'remote-sensing',
};

// slug -> title for every published post, so the mind map only links to pages that exist
const postIndex: Record<string, string> = Object.fromEntries(all.map(a => [a.slug, a.data.title]));

const sections = clusters.map(c => {
  const posts = all.filter(a => a.data.cluster === c.id).sort(byChapter);
  const featured = posts.find(p => p.data.featured);
  const rest = posts.filter(p => p !== featured);
  const groups = c.groups
    ? c.groups.map(g => ({ ...g, posts: rest.filter(p => g.majors.includes(chapterKey(p.data.chapter)[0])) }))
    : [{ label: '', sub: '', majors: [], posts: rest }];
  // anything without a matching group still shows up, at the end
  const placed = new Set(groups.flatMap(g => g.posts));
  const loose = rest.filter(p => !placed.has(p));
  if (loose.length) groups.push({ label: 'More', sub: '', majors: [], posts: loose });
  return { cluster: c, posts, featured, groups: groups.filter(g => g.posts.length) };
});
---

<BaseLayout title="Stories" activePage="home">

  <!-- ── Intro ─────────────────────────────────────────────── -->
  <section class="home-top container">
    <div class="top-eyebrow">
      <span class="eyebrow-dot"></span>
      <span>Geospatial Storytelling · Southeast Asia</span>
    </div>
    <h1 class="top-headline">Maps that <em>tell the story.</em></h1>
    <p class="top-body">
      Spatial analysis, remote sensing and data-driven narratives on fire, drought and disaster risk
      in Riau, Indonesia. Stories are grouped into clusters; start with the first.
    </p>
  </section>

  {sections.map(({ cluster, posts, featured, groups }) => (
    <section class="cluster container" id={`cluster-${cluster.id}`} aria-labelledby={`cluster-${cluster.id}-title`}>

      <header class="cluster-head">
        <div class="cluster-kicker">
          <span class="cluster-num">Cluster {cluster.number}</span>
          <span class="cluster-label">{cluster.label}</span>
        </div>
        <h2 class="cluster-title" id={`cluster-${cluster.id}-title`}>{cluster.title}</h2>
        <p class="cluster-sub">{cluster.subtitle}</p>
        <p class="cluster-blurb">{cluster.blurb}</p>
        <div class="cluster-foot">
          <ul class="cluster-meta">
            <li><b>{posts.length}</b> {posts.length === 1 ? 'story' : 'stories'}</li>
            <li><b>11</b> kecamatan</li>
            <li><b>10 yr</b> satellite record</li>
            <li>Universitas Riau · S2</li>
          </ul>
          {cluster.mindmap && (
            <ThesisMindMap client:load data={mindmap} posts={postIndex} base={BASE} label="Thesis mind map" />
          )}
        </div>
      </header>

      {featured && (
        <a href={`${BASE}/${featured.slug}`} class="feature-card">
          <div class="feature-meta">
            <span class="start-here">Start here</span>
            <time class="feature-date">
              {new Date(featured.data.date).toLocaleDateString('en-GB', {year:'numeric',month:'short',day:'numeric'})}
            </time>
          </div>
          <h3 class="feature-title">{featured.data.title}</h3>
          {featured.data.subtitle && <p class="feature-sub">{featured.data.subtitle}</p>}
          <div class="feature-cta">Read the overview <span class="cta-arrow">→</span></div>
        </a>
      )}

      {groups.map(g => (
        <div class="group">
          {g.label && (
            <div class="group-head">
              <h3>{g.label}</h3>
              {g.sub && <span>{g.sub}</span>}
            </div>
          )}
          <div class="articles-grid">
            {g.posts.map(article => (
              <a href={`${BASE}/${article.slug}`} class="article-card">
                <div class="card-top">
                  {article.data.chapter && <span class="card-chapter">§ {article.data.chapter}</span>}
                  <div class="card-tags">
                    {article.data.tags.slice(0, 2).map(tag => (
                      <span class={`tag ${tagColorMap[tag] ?? ''}`}>{tag}</span>
                    ))}
                  </div>
                </div>
                <h4 class="card-title">{article.data.title}</h4>
                {article.data.subtitle && <p class="card-sub">{article.data.subtitle}</p>}
                <div class="card-footer">
                  <time>{new Date(article.data.date).toLocaleDateString('en-GB',{year:'numeric',month:'short'})}</time>
                  <span class="card-read">Read →</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      ))}
    </section>
  ))}

  <!-- ── About strip ───────────────────────────────────────── -->
  <section class="about-strip container">
    <div class="strip-inner">
      <div class="strip-text">
        <div class="section-label">
          <span class="label-line"></span>
          <span>About this project</span>
        </div>
        <p>
          <strong>medrifmaps</strong> is the geospatial research portfolio of mamed/rifqy —
          a geospatial analyst based in Riau Province, Indonesia, pursuing an S2 in
          Disaster Management at Universitas Riau. The work spans peatland fire
          analysis, mangrove rehabilitation mapping, and machine learning for
          disaster risk reduction.
        </p>
        <a href={`${BASE}/about`} class="strip-link">Learn more about the project →</a>
      </div>
      <div class="strip-tools">
        <div class="tools-label">Tools & data sources</div>
        <div class="tools-grid">
          {['Google Earth Engine','DBSCAN','Sentinel-1 SAR','Sentinel-2','CHIRPS v2.0','ERA5-Land','Hansen GFC','NASA FIRMS (MODIS)','MapLibre GL JS'].map(t => (
            <div class="tool-chip">{t}</div>
          ))}
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
/* ── Intro ─────────────────────────────────────────────────── */
.home-top { padding-top: calc(var(--nav-h) + 3.5rem); padding-bottom: 2.5rem; }
.top-eyebrow {
  display: flex; align-items: center; gap: 0.6rem;
  font-size: 0.72rem; font-weight: 700; letter-spacing: 0.12em;
  text-transform: uppercase; color: var(--teal); margin-bottom: 1.25rem;
}
.eyebrow-dot { width: 6px; height: 6px; background: var(--teal); border-radius: 50%; box-shadow: 0 0 8px var(--teal); }
.top-headline {
  font-size: clamp(2.2rem, 5.5vw, 3.8rem); font-weight: 900; letter-spacing: -0.03em;
  line-height: 1.02; margin-bottom: 1rem; color: var(--text-bright);
}
.top-headline em { font-style: italic; color: var(--teal); }
.top-body { font-size: 1rem; color: var(--text-muted); line-height: 1.65; max-width: 560px; margin: 0; }

/* ── Cluster ───────────────────────────────────────────────── */
.cluster { padding-bottom: 3rem; }
.cluster-head {
  padding: 2rem 2rem 1.75rem;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-top: 3px solid var(--teal);
  border-radius: 6px;
  margin-bottom: 1.5px;
}
.cluster-kicker { display: flex; align-items: center; gap: .9rem; flex-wrap: wrap; margin-bottom: 1rem; }
.cluster-num { font-size: .7rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: #0d0e0f; background: var(--teal); padding: .2rem .55rem; border-radius: 3px; }
.cluster-label { font-size: .72rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--text-dim); }
.cluster-title {
  font-family: var(--font-display); font-size: clamp(1.4rem, 3vw, 2.1rem); line-height: 1.2;
  color: var(--text-bright); letter-spacing: -0.01em; margin: 0 0 .6rem; max-width: 880px;
}
.cluster-sub { font-size: 1rem; color: var(--gold); margin: 0 0 .9rem; font-style: italic; font-family: var(--font-display); }
.cluster-blurb { font-size: .92rem; color: var(--text-muted); line-height: 1.65; max-width: 700px; margin: 0 0 1.5rem; }
.cluster-foot { display: flex; align-items: center; justify-content: space-between; gap: 1.25rem 2rem; flex-wrap: wrap; padding-top: 1.25rem; border-top: 1px solid var(--border); }
.cluster-meta { display: flex; flex-wrap: wrap; gap: .4rem 1.75rem; list-style: none; margin: 0; padding: 0; font-size: .78rem; color: var(--text-muted); }
.cluster-meta b { font-family: var(--font-display); font-size: 1.15rem; color: var(--text-bright); margin-right: .25rem; font-weight: 700; }

/* Feature card */
.feature-card {
  display: block; padding: 1.75rem 2rem;
  background: var(--bg-card); border: 1px solid var(--border); border-left: 4px solid var(--gold);
  border-radius: 6px; text-decoration: none; margin-bottom: 1.5px;
  transition: background 0.2s, border-left-color 0.2s;
}
.feature-card:hover { background: var(--bg-hover); border-left-color: var(--teal); }
.feature-meta { display: flex; align-items: center; justify-content: space-between; margin-bottom: .8rem; flex-wrap: wrap; gap: .5rem; }
.start-here { font-size: .68rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: var(--gold); }
.feature-date { font-size: 0.78rem; color: var(--text-dim); }
.feature-title { font-family: var(--font-display); font-size: clamp(1.25rem, 2.6vw, 1.7rem); color: var(--text-bright); line-height: 1.2; margin: 0 0 .6rem; letter-spacing: -0.01em; }
.feature-sub { font-size: 0.92rem; color: var(--text-muted); max-width: 680px; line-height: 1.6; margin: 0 0 1.1rem; }
.feature-cta { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--teal); display: flex; align-items: center; gap: 0.4rem; }
.cta-arrow { transition: transform 0.2s; }
.feature-card:hover .cta-arrow { transform: translateX(4px); }

/* Groups and cards */
.group { margin-top: 2.25rem; }
.group-head { display: flex; align-items: baseline; gap: .9rem 1.25rem; flex-wrap: wrap; margin-bottom: .9rem; }
.group-head h3 { font-family: var(--font-display); font-size: 1.15rem; color: var(--text-bright); margin: 0; }
.group-head span { font-size: .76rem; color: var(--text-dim); letter-spacing: .02em; }
.articles-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr)); gap: 1.5px; }
.article-card {
  display: flex; flex-direction: column; padding: 1.5rem 1.6rem;
  background: var(--bg-card); border: 1px solid var(--border); text-decoration: none;
  transition: background 0.2s; border-radius: 4px;
}
.article-card:hover { background: var(--bg-hover); }
.card-top { display: flex; align-items: center; justify-content: space-between; gap: .5rem; flex-wrap: wrap; margin-bottom: .75rem; }
.card-chapter { font-size: .68rem; font-weight: 800; letter-spacing: .08em; color: var(--teal); text-transform: uppercase; font-variant-numeric: tabular-nums; }
.card-tags { display: flex; gap: 0.35rem; flex-wrap: wrap; }
.card-title { font-family: var(--font-display); font-size: 1.1rem; color: var(--text-bright); line-height: 1.25; margin: 0 0 0.5rem; }
.card-sub { font-size: 0.84rem; color: var(--text-muted); line-height: 1.55; flex: 1; margin: 0 0 1rem; }
.card-footer {
  display: flex; justify-content: space-between; align-items: center; font-size: 0.78rem; color: var(--text-dim);
  padding-top: 0.75rem; border-top: 1px solid var(--border); margin-top: auto;
}
.card-read { color: var(--teal); font-weight: 600; }
.article-card:hover .card-read { color: var(--gold); }

.section-label {
  display: flex; align-items: center; gap: 0.75rem;
  font-size: 0.7rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-dim);
}
.label-line { width: 24px; height: 1px; background: var(--teal); }

@media (max-width: 640px) {
  .cluster-head { padding: 1.4rem 1.2rem; }
  .feature-card { padding: 1.4rem 1.2rem; }
  .article-card { padding: 1.3rem 1.2rem; }
}

/* ── About strip ───────────────────────────────────────────── */
.about-strip { padding: 4rem 0 5rem; }
.strip-inner {
  display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: start;
}
.strip-text .section-label { margin-bottom: 1.25rem; }
.strip-text p { font-size: 0.95rem; color: var(--text-muted); line-height: 1.7; margin-bottom: 1rem; }
.strip-link { font-size: 0.85rem; font-weight: 700; color: var(--teal); letter-spacing: 0.02em; }
.strip-link:hover { color: var(--gold); }

.tools-label { font-size: 0.68rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-dim); margin-bottom: 1rem; }
.tools-grid { display: flex; flex-wrap: wrap; gap: 0.5rem; }
.tool-chip {
  font-size: 0.75rem; font-weight: 600;
  color: var(--text-muted);
  border: 1px solid var(--border);
  padding: 0.3em 0.75em; border-radius: 3px;
  background: var(--bg-card);
  transition: border-color 0.15s, color 0.15s;
}
.tool-chip:hover { border-color: var(--teal); color: var(--teal); }

@media (max-width: 768px) {
  .strip-inner { grid-template-columns: 1fr; gap: 2rem; }
  .hero-stats { gap: 1rem; }
  .hstat-sep { display: none; }
  .hstat { padding: 0 1rem 0 0; }
}
</style>
